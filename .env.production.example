# Production settings. Copy to .env.production (git-ignored, never commit it) and fill in every value.
# docker-compose.prod.yml reads this file; on another host set the same variables in its dashboard.
# The container refuses to start without APP_KEY, FRONTEND_URL and a MySQL database, or with APP_DEBUG=true.

APP_NAME=Saanjh
APP_ENV=production
APP_DEBUG=false
# Generate once and keep it: php artisan key:generate --show
APP_KEY=
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Kolkata

# The storefront. Emails link here, and it is the only origin CORS allows unless CORS_ALLOWED_ORIGINS is set.
FRONTEND_URL=https://shop.example.com
# CORS_ALLOWED_ORIGINS=https://shop.example.com,https://www.shop.example.com

# Caddy requests the HTTPS certificate for this name — point its DNS at the server first.
API_DOMAIN=api.example.com
# The app is only reachable through Caddy, so its X-Forwarded-* headers can be trusted.
TRUSTED_PROXIES=*
FORCE_HTTPS=true

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=saanjh
DB_USERNAME=saanjh
DB_PASSWORD=
# Only used to initialise the MySQL container.
DB_ROOT_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12

# Order confirmations, status updates and password resets. Any SMTP provider works
# (port 587 = STARTTLS; for port 465 also set MAIL_SCHEME=smtps).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@example.com
MAIL_FROM_NAME=Saanjh

# Razorpay live keys (rzp_live_…). Leave both empty to offer Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: https://<APP_URL host>/api/v1/payments/razorpay/webhook,
# events payment.captured, payment.failed, order.paid — and the same secret here.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_UNPAID_ORDER_TTL=30

# Created by the first `php artisan db:seed --force`. 12+ characters, not the README default.
ADMIN_NAME="Store Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

SHOP_FREE_SHIPPING_THRESHOLD=499
SHOP_SHIPPING_FEE=49
SHOP_LOW_STOCK_THRESHOLD=10
