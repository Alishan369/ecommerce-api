APP_NAME=Saanjh
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata
# Production: your storefront origin(s), comma-separated. '*' is fine locally.
CORS_ALLOWED_ORIGINS=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perfume_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys until go-live.
# Leave empty to offer Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL https://<your-domain>/api/v1/payments/razorpay/webhook,
# events payment.captured, payment.failed, order.paid — and the same secret here.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_UNPAID_ORDER_TTL=30

# Seeded admin (php artisan db:seed --class=AdminUserSeeder). Change the password for production!
ADMIN_NAME="Store Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# Shipping: free above the threshold, otherwise the flat fee (INR).
SHOP_FREE_SHIPPING_THRESHOLD=499
SHOP_SHIPPING_FEE=49
SHOP_LOW_STOCK_THRESHOLD=10

VITE_APP_NAME="${APP_NAME}"
